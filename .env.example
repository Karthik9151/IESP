# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/iesp

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional threat-intelligence providers
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_API_KEY=

# Mail integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# IESP API
IESP_ENVIRONMENT=development
IESP_AUTH_MODE=required
IESP_API_KEY=replace-with-a-long-random-secret
IESP_ALLOWED_ORIGINS=http://localhost:3000
IESP_MAX_REQUEST_BYTES=1048576
